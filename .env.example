DATABASE_URL=postgres://postgres:postgres@localhost:5432/opencode_crm
AUTH_SECRET=replace-with-a-random-32-byte-secret
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
NODE_ENV=development
IMAGE_STORAGE_DIR=./storage/listing-images

# Outbound email (optional). Messaging stays draft-only until SMTP_HOST and
# MESSAGING_FROM are set. MESSAGING_TRANSPORT=fake bypasses delivery locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_ALLOW_PLAINTEXT=false
MESSAGING_FROM="OpenCRM <crm@example.com>"
MESSAGING_MAX_RECIPIENTS=100
